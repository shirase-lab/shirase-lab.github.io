# 変換前の大容量ソース動画（サイトには変換済み feature_*.mp4 / 1.2.0features.mp4 を使用）
movies/

# schedules/: 平文・パスフレーズ・ログ・内部フルは公開しない（追跡する暗号文は公開版 live.json だけ）。
# ⚠ 内部フル（uchiwa_demand/notes/lineup_note 等・SNS施策データ）はこの公開リポジトリに置かない。
#   アプリが復号パスフレーズを同梱している（lib/data/live_schedule_service.dart）ため、この公開ホストに
#   同じ鍵で暗号化したファイルを置くと誰でも復号できてしまう。内部フルはリポジトリ外
#   （D:/ShiraseLab/oshimite.jp.live.internal.json）に置き、公開ホストへは make_public.py で
#   内部項目を除いた live.json だけを出す。
schedules/live.internal.json
schedules/*.plain.json
schedules/live.source.json
schedules/live.public.json
schedules/live.new.json
schedules/live.prev.json
schedules/found.json
schedules/logs/
*.passwd

# narration/: 生成物（音声/原稿/ログ/状態/確定声）は公開しない（スクリプト/README/config は追跡）
narration/output/
narration/work/
narration/state/
narration/logs/
narration/reference_voice.wav

